# ==============================================================================
# RoadTwin AI — Environment Configuration Template
# Smart India Hackathon 2026
#
# IMPORTANT:
# - Copy this file to `.env` or `.env.local` for local execution.
# - DO NOT commit real secrets or API keys to version control.
# ==============================================================================

# Application Environment: development, test, production
ENVIRONMENT=development

# Backend Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Frontend API Endpoint
NEXT_PUBLIC_API_URL=http://localhost:8000

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# SQLite Persistent Database Path
DATABASE_PATH=data/processed/digital_twin/alerts.db

# Live Traffic API Key (Optional)
# If left empty, system operates in validated MOCK_OR_UNAVAILABLE mode with survey baseline fallback.
TOMTOM_API_KEY=your_tomtom_api_key_here

# Map Rendering: MapLibre GL JS (No proprietary token or account required)
# RoadTwin corridor geometry is served locally from public/data/

# Operational State Polling Interval in Seconds
POLLING_INTERVAL_SEC=30
